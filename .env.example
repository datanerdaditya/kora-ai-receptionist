# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys.

# LiveKit Cloud project (Settings > Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech to text and voice
DEEPGRAM_API_KEY=

# LLM
ANTHROPIC_API_KEY=

# Password for the /admin page (user "admin"). Leave empty to switch admin off.
ADMIN_PASSWORD=

# Optional
# CLINIC_ID=riviere-dental
# BOOKINGS_DB=data/bookings.db
